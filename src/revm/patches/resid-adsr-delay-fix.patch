--- a/envelope.h
+++ b/envelope.h
@@ -74,6 +74,28 @@ protected:
   bool hold_zero;
   bool reset_rate_counter;
 
+  // C64 Rework: the real chip's "ADSR delay bug". When a rate counter is
+  // already past a newly selected (shorter) rate period, it counts up to
+  // 0x8000 and wraps before the envelope steps: up to ~33 ms late.
+  //   0 = real chip (default)
+  //   1 = fix-attack: no delay when entering attack (note-ons on time;
+  //       releases keep the chip's delay)
+  //   2 = fix: no delay anywhere
+  //   3 = fix-attack-soft: as 1, but a note-on keeps the chip's delay divided
+  //       by adsr_soft_divisor, so attacks keep a little of their natural spread
+  // Set at init time (SID::set_adsr_mode).
+  int adsr_mode;
+  // Cycles left of a divided attack delay (mode 3); 0 = none running.
+  cycle_count adsr_soft_remaining;
+  static const int adsr_soft_divisor = 5;
+
+  bool adsr_skip_now() const {
+    return adsr_mode == 2 || (adsr_mode == 1 && state == ATTACK);
+  }
+  bool adsr_soft_now() const {
+    return adsr_mode == 3 && state == ATTACK;
+  }
+
   reg4 attack;
   reg4 decay;
   reg4 sustain;
@@ -184,12 +206,32 @@ void EnvelopeGenerator::clock()
   // This has been verified by sampling ENV3.
   //
   if (likely(rate_counter != rate_period)) {
-    if (unlikely(++rate_counter & 0x8000)) {
-      ++rate_counter &= 0x7fff;
+    if (unlikely(rate_counter > rate_period && adsr_skip_now())) {
+      // C64 Rework: step as if the period was reached (see adsr_mode).
+      reset_rate_counter = true;
+    }
+    else if (unlikely(rate_counter > rate_period && adsr_soft_now())) {
+      // C64 Rework: the chip's delay (counting up to 0x8000, wrapping and
+      // reaching the period again) divided by adsr_soft_divisor.
+      if (adsr_soft_remaining == 0) {
+        adsr_soft_remaining =
+          (0x8000 - rate_counter + rate_period) / adsr_soft_divisor + 1;
+      }
+      if (--adsr_soft_remaining == 0) {
+        reset_rate_counter = true;
+      }
+    }
+    else {
+      adsr_soft_remaining = 0;
+      if (unlikely(++rate_counter & 0x8000)) {
+        ++rate_counter &= 0x7fff;
+      }
     }
   }
-  else
+  else {
+    adsr_soft_remaining = 0;
     reset_rate_counter = true;
+  }
 }
 
 
